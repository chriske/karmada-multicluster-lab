{
  "annotations": {
    "list": [
      {
        "name": "Kubernetes Warning Events",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "enable": true,
        "hide": false,
        "iconColor": "rgba(230, 126, 34, 1)",
        "expr": "{source_type=\"k8s-event\",source_cluster=~\"(dc-primary|dc-secondary|cloud-azure|karmada-mgmt)\"} | json | type=\"Warning\"",
        "target": {},
        "showIn": 0
      },
      {
        "name": "Lab scenario markers",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "enable": true,
        "hide": false,
        "iconColor": "rgba(54, 162, 235, 1)",
        "expr": "{source_type=\"scenario-marker\"} | json | scenario!=\"verify\"",
        "target": {},
        "showIn": 0
      },
      {
        "name": "Kubernetes Normal Events",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "enable": false,
        "hide": false,
        "iconColor": "rgba(80, 200, 120, 1)",
        "expr": "{source_type=\"k8s-event\",source_cluster=~\"(dc-primary|dc-secondary|cloud-azure|karmada-mgmt)\"} | json | type=\"Normal\"",
        "target": {},
        "showIn": 0
      }
    ]
  },
