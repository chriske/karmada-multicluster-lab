{
  "annotations": {
    "list": [
      {
        "name": "Kubernetes Warning Events",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "enable": true,
        "hide": false,
        "iconColor": "rgba(230, 126, 34, 1)",
        "expr": "{source_type=\"k8s-event\",source_cluster=~\"(dc-primary|dc-secondary|cloud-azure|karmada-mgmt)\"} | json | type=\"Warning\"",
        "target": {},
        "showIn": 0
      },
      {
        "name": "Lab scenario markers",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "enable": true,
        "hide": false,
        "iconColor": "rgba(54, 162, 235, 1)",
        "expr": "{source_type=\"scenario-marker\"} | json | scenario!=\"verify\"",
        "target": {},
        "showIn": 0
      },
      {
        "name": "Kubernetes Normal Events",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "enable": false,
        "hide": false,
        "iconColor": "rgba(80, 200, 120, 1)",
        "expr": "{source_type=\"k8s-event\",source_cluster=~\"(dc-primary|dc-secondary|cloud-azure|karmada-mgmt)\"} | json | type=\"Normal\"",
        "target": {},
        "showIn": 0
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "Member readiness",
      "type": "bargauge",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "cluster_ready_state",
          "legendFormat": "{{member_cluster}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false
        }
      ],
      "description": "1=Ready; 0=NotReady",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "cloud-azure"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#73BF69"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "dc-primary"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#FADE2A"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "dc-secondary"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#5794F2"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true
      }
    },
